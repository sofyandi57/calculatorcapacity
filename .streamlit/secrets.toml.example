# Salin file ini menjadi .streamlit/secrets.toml (jangan di-commit ke git).

# --- Database (opsional) ---
# Connection string PostgreSQL dari project Supabase Anda.
# Kalau baris ini tidak ada / gagal konek, aplikasi otomatis fallback
# ke SQLite lokal (file local_data.db) tanpa error.
SUPABASE_DB_URL = "postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres"

# --- Akun Master (opsional) ---
# Login cepat tanpa perlu daftar akun di database dulu. Kalau kedua baris
# ini diisi, kombinasi username/password ini akan selalu bisa login,
# terpisah dari akun-akun yang didaftarkan lewat form "Daftar Akun Baru".
APP_USERNAME = "admin"
APP_PASSWORD = "ganti-dengan-password-kuat"
